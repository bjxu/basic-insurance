{
  "name": "basic-insurance (Claude sandbox)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Europe/Zurich}"
    }
  },
  // NET_ADMIN/NET_RAW are needed only so init-firewall.sh can set iptables rules
  // inside the container's own network namespace. It never touches the host's.
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": { "zsh": { "path": "/bin/zsh" } }
      }
    }
  },
  "remoteUser": "node",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=basic-insurance-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=basic-insurance-claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer/.secrets/gh-token,target=/home/node/.gh-token,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/home/node/.gitconfig-host,type=bind,readonly"
  ],
  "remoteEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true"
  },
  // Common dev-server ports; add/remove once the project's actual stack is known.
  "forwardPorts": [3000, 4200, 5173, 8080],
  "postCreateCommand": "bash /workspace/.devcontainer/postCreate.sh"
}
